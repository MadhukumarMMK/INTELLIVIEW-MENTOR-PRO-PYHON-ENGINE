# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Audio mode for the SER (speech emotion recognition) pipeline.
#   real → load the trained 2D-CNN .h5 model (needs ~1 GB RAM, more accurate)
#   size → byte-count heuristic (lightweight, no model load)
AUDIO_MODE=real
